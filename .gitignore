# rea-plus .gitignore — derleme çıktıları ve yerel sırlar repoya girmez.
node_modules/
dist/
dist-release/
*.log
.env
coverage/
.DS_Store
# Derleme artığı (tsc incremental açık değil ama yine de dışarıda tutulur).
*.tsbuildinfo
# Python artığı (Ghidra scriptleri yanında üretilir).
__pycache__/
*.pyc
sbom.cdx.json
# Portable bundle çıktısı (scripts/portable-paketle.mjs; release asset'i kaynağı).
portable/
